<%# Shared partial for new/edit vendor %>
<div style="max-width:430px; margin:0 auto; min-height:100vh; background:#f5f5f5;">

  <%# Header %>
  <div style="background:white; padding:18px 20px 14px 20px; border-bottom:1px solid #ececec; position:sticky; top:0; z-index:30; margin-bottom:16px;">
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <%= link_to "←", vendors_path, style: "font-size:24px; color:#111; text-decoration:none; font-weight:800;" %>
      <div style="font-size:20px; font-weight:900;"><%= vendor.new_record? ? "업체 등록" : "업체 수정" %></div>
      <div style="width:40px;"></div>
    </div>
  </div>

  <div style="padding:0 16px 100px 16px;">
    <% if vendor.errors.any? %>
      <div style="background:#fee2e2; color:#dc2626; border-radius:14px; padding:12px 16px; margin-bottom:16px; font-size:14px; font-weight:700;">
        <%= vendor.errors.full_messages.first %>
      </div>
    <% end %>

    <%= form_with model: vendor, local: true do |f| %>
      <div style="background:white; border-radius:16px; padding:18px; box-shadow:0 2px 8px rgba(0,0,0,0.04); display:flex; flex-direction:column; gap:16px;">

        <%# 업체 구분 %>
        <div>
          <label style="font-size:13px; font-weight:800; color:#374151; display:block; margin-bottom:6px;">구분 *</label>
          <div style="display:flex; gap:12px;" id="vendor_type_container">
            <label style="flex:1; display:flex; align-items:center; justify-content:center; padding:12px; border:1px solid #2563eb; border-radius:12px; background:#eff6ff;">
              <%= f.hidden_field :vendor_type, value: "company" %>
              <span style="font-size:14px; font-weight:800; color:#1d4ed8;">🏢 업체</span>
            </label>
          </div>
        </div>

        <%# AI 스캔 %>
        <div style="margin-bottom:8px;">
          <input type="file" id="ai_scan_input" accept="image/*" capture="environment" style="display:none;" />
          <button type="button" id="ai_scan_btn" style="width:100%; height:52px; background:linear-gradient(135deg, #2563eb, #7c3aed); color:white; border:none; border-radius:14px; font-size:15px; font-weight:800; cursor:pointer; display:flex; justify-content:center; align-items:center; gap:8px; box-shadow:0 4px 12px rgba(37,99,235,0.2);">
            <span>📸</span> 명함/사업자등록증 AI 스캔
          </button>
          
          <div id="ai_scan_loading" style="display:none; padding:16px; text-align:center; background:#f3f4f6; border-radius:14px; margin-top:8px;">
            <div style="font-size:14px; font-weight:700; color:#4b5563; display:flex; align-items:center; justify-content:center; gap:8px;">
              <span class="spinner" style="display:inline-block; width:16px; height:16px; border:2px solid #2563eb; border-radius:50%; border-top-color:transparent; animation:spin 1s linear infinite;"></span>
              AI가 이미지를 분석하고 있습니다...
            </div>
            <style>
              @keyframes spin { 100% { transform:rotate(360deg); } }
            </style>
          </div>
        </div>

        <script>
          document.addEventListener('DOMContentLoaded', function() {
            var scanBtn = document.getElementById('ai_scan_btn');
            var scanInput = document.getElementById('ai_scan_input');
            var scanLoading = document.getElementById('ai_scan_loading');
            
            if (scanBtn && scanInput) {
              scanBtn.addEventListener('click', function() {
                scanInput.click();
              });
              
              scanInput.addEventListener('change', function(e) {
                var file = e.target.files[0];
                if (!file) return;
                
                scanBtn.style.display = 'none';
                scanLoading.style.display = 'block';
                
                var formData = new FormData();
                formData.append('image', file);
                
                var csrfToken = document.querySelector('meta[name="csrf-token"]');
                var token = csrfToken ? csrfToken.content : '';
                
                fetch('/ai_registrations/analyze_image', {
                  method: 'POST',
                  headers: {
                    'X-CSRF-Token': token
                  },
                  body: formData
                })
                .then(response => response.json().then(data => ({ status: response.status, body: data })))
                .then(result => {
                  scanLoading.style.display = 'none';
                  scanBtn.style.display = 'flex';
                  scanInput.value = '';
                  
                  if (result.status === 200 && result.body.success) {
                    var data = result.body.data;
                    
                    if (data.vendor_name) document.getElementById('vendor_name').value = data.vendor_name;
                    if (data.contact_name) document.getElementById('vendor_contact_name').value = data.contact_name;
                    if (data.phone) {
                      var phoneInput = document.getElementById('vendor_phone_input');
                      if (phoneInput && typeof formatPhoneNumber === 'function') {
                        phoneInput.value = formatPhoneNumber(data.phone);
                      } else if (phoneInput) {
                        phoneInput.value = data.phone;
                      }
                    }
                    if (data.business_number) document.getElementById('vendor_business_number').value = data.business_number;
                    if (data.address) {
                      document.getElementById('vendor_address').value = data.address;
                      var addressText = document.getElementById('vendor_address_display_text');
                      if (addressText) {
                        addressText.textContent = data.address;
                        addressText.style.color = '#111827';
                      }
                    }
                  } else {
                    alert(result.body.error || '분석 중 오류가 발생했습니다.');
                  }
                })
                .catch(error => {
                  scanLoading.style.display = 'none';
                  scanBtn.style.display = 'flex';
                  scanInput.value = '';
                  alert('네트워크 오류가 발생했습니다. 다시 시도해주세요.');
                  console.error(error);
                });
              });
            }
          });
        </script>

        <%# 업체명 %>
        <div>
          <label style="font-size:13px; font-weight:800; color:#374151; display:block; margin-bottom:6px;"><span id="vendor-name-label">업체명</span> *</label>
          <%= f.text_field :name, placeholder: "업체명 또는 고객명을 등록해 주세요",
              style: "width:100%; height:48px; border:1.5px solid #e5e7eb; border-radius:12px; padding:0 14px; font-size:15px; font-weight:700; font-family:inherit; box-sizing:border-box;" %>
        </div>

        <%# 고객명 %>
        <div>
          <label style="font-size:13px; font-weight:800; color:#374151; display:block; margin-bottom:6px;">고객명</label>
          <%= f.text_field :contact_name, placeholder: "담당자 이름 (예: 김부장)",
              style: "width:100%; height:48px; border:1.5px solid #e5e7eb; border-radius:12px; padding:0 14px; font-size:15px; font-weight:700; font-family:inherit; box-sizing:border-box;" %>
        </div>

        <%# 전화번호 %>
        <div>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
            <label style="font-size:13px; font-weight:800; color:#374151;">전화번호</label>
            <button type="button" id="import_contact_btn" style="background:none; border:none; color:#2563eb; font-size:13px; font-weight:800; padding:0; cursor:pointer; display:none;">
              📞 연락처 불러오기
            </button>
          </div>
          <%= f.telephone_field :phone, placeholder: "010-0000-0000", id: "vendor_phone_input",
              style: "width:100%; height:48px; border:1.5px solid #e5e7eb; border-radius:12px; padding:0 14px; font-size:15px; font-weight:700; font-family:inherit; box-sizing:border-box;" %>
        </div>

        <%# 사업장주소 %>
        <div>
          <label style="font-size:13px; font-weight:800; color:#374151; display:block; margin-bottom:6px;">사업장주소</label>
          <%= f.hidden_field :address, id: "vendor_address" %>
          
          <button type="button"
                  id="vendor_address_search_button"
                  style="width:100%; height:48px; border:1.5px solid #e5e7eb; border-radius:12px; background:white; color:#374151; font-size:15px; font-weight:700; text-align:left; padding:0 14px; display:flex; justify-content:space-between; align-items:center;">
            <span id="vendor_address_display_text" style="color:<%= vendor.address.present? ? '#111827' : '#9ca3af' %>; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
              <%= vendor.address.presence || "주소 검색 (클릭)" %>
            </span>
            <span style="font-size:16px;">🔍</span>
          </button>

          <% detail_addr = vendor.address.to_s.split(" ").last(2).join(" ") rescue "" %>
          <input type="text"
                 id="vendor_detail_address"
                 name="detail_address"
                 placeholder="상세주소 입력"
                 style="margin-top:8px; width:100%; height:48px; border:1.5px solid #e5e7eb; border-radius:12px; padding:0 14px; font-size:15px; font-weight:700; font-family:inherit; box-sizing:border-box;">
        </div>

        <%# 사업자등록번호 %>
        <div>
          <label style="font-size:13px; font-weight:800; color:#374151; display:block; margin-bottom:6px;">사업자등록번호</label>
          <%= f.text_field :business_number, placeholder: "000-00-00000",
              style: "width:100%; height:48px; border:1.5px solid #e5e7eb; border-radius:12px; padding:0 14px; font-size:15px; font-weight:700; font-family:inherit; box-sizing:border-box;" %>
        </div>

        <script>
          function formatPhoneNumber(value) {
            if (!value) return value;
            value = value.replace(/[^0-9]/g, '');
            if (!value) return '';
            
            if (value.startsWith('02')) {
              if (value.length <= 2) return value;
              if (value.length <= 5) return value.replace(/(\d{2})(\d{1,3})/, '$1-$2');
              if (value.length <= 9) return value.replace(/(\d{2})(\d{3})(\d{1,4})/, '$1-$2-$3');
              return value.replace(/(\d{2})(\d{4})(\d{1,4})/, '$1-$2-$3');
            } else if (value.startsWith('15') || value.startsWith('16') || value.startsWith('18')) {
              if (value.length <= 4) return value;
              return value.replace(/(\d{4})(\d{1,4})/, '$1-$2');
            } else {
              if (value.length <= 3) return value;
              if (value.length <= 7) return value.replace(/(\d{3})(\d{1,3})/, '$1-$2');
              return value.replace(/(\d{3})(\d{4})(\d{1,4})/, '$1-$2-$3');
            }
          }

          document.addEventListener('DOMContentLoaded', function() {
            var phoneInput = document.getElementById('vendor_phone_input');
            if (phoneInput && !phoneInput.dataset.formatted) {
              phoneInput.dataset.formatted = 'true';
              phoneInput.value = formatPhoneNumber(phoneInput.value);
              phoneInput.addEventListener('input', function(e) {
                e.target.value = formatPhoneNumber(e.target.value);
              });
            }
          });
        </script>

        <script>
          // 연락처 불러오기 로직 (Turbo 대응을 위해 DOMContentLoaded 외부에 배치)
          (function() {
            function checkContactSupport() {
              var isCapacitor = !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform());
              if (isCapacitor || ('contacts' in navigator && 'ContactsManager' in window)) {
                var importBtn = document.getElementById('import_contact_btn');
                if (importBtn) importBtn.style.display = 'block';
              }
            }

            // 약간 지연 후 확인 (Capacitor 플러그인 로드 대기)
            setTimeout(checkContactSupport, 500);

            var importBtn = document.getElementById('import_contact_btn');
            if (importBtn && !importBtn.dataset.listenerAttached) {
              importBtn.dataset.listenerAttached = 'true';
              importBtn.addEventListener('click', async function() {
                try {
                  if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.Contacts) {
                    try {
                      const perm = await window.Capacitor.Plugins.Contacts.checkPermissions();
                      if (perm.contacts !== 'granted') {
                        const req = await window.Capacitor.Plugins.Contacts.requestPermissions();
                        if (req.contacts !== 'granted') {
                          alert('연락처 접근 권한이 거부되어 있습니다. 앱 설정에서 권한을 허용해주세요.');
                          return;
                        }
                      }
                    } catch(e) {
                      console.warn('Permission check failed', e);
                    }
                    
                    const result = await window.Capacitor.Plugins.Contacts.pickContact({ projection: { name: true, phones: true } });
                    if (result && result.contact) {
                      const contact = result.contact;
                      
                      // 이름 세팅
                      const nameInput = document.getElementById('vendor_name');
                      if (nameInput && !nameInput.value && contact.name && contact.name.display) {
                        nameInput.value = contact.name.display;
                      }

                      // 번호 세팅
                      if (contact.phones && contact.phones.length > 0) {
                        if (contact.phones.length === 1) {
                          // 번호가 1개일 땐 바로 세팅
                          let phoneVal = contact.phones[0].number || contact.phones[0];
                          if (phoneVal && typeof phoneVal === 'object') phoneVal = phoneVal.number;
                          const phoneInput = document.getElementById('vendor_phone_input');
                          if (phoneVal && phoneInput) phoneInput.value = formatPhoneNumber(phoneVal);
                        } else {
                          // 번호가 여러 개일 때 모달 띄우기
                          showPhoneSelector(contact.phones, function(selectedPhone) {
                            const phoneInput = document.getElementById('vendor_phone_input');
                            if (selectedPhone && phoneInput) phoneInput.value = formatPhoneNumber(selectedPhone);
                          });
                        }
                      }
                    }
                  } else if ('contacts' in navigator && 'ContactsManager' in window) {
                    try {
                      const contacts = await navigator.contacts.select(['name', 'tel'], { multiple: false });
                      if (contacts.length > 0) {
                        const contact = contacts[0];
                        const nameInput = document.getElementById('vendor_name');
                        if (nameInput && !nameInput.value && contact.name && contact.name.length > 0) {
                          nameInput.value = contact.name[0];
                        }
                        if (contact.tel && contact.tel.length > 0) {
                          if (contact.tel.length === 1) {
                            const phoneInput = document.getElementById('vendor_phone_input');
                            if (phoneInput) phoneInput.value = formatPhoneNumber(contact.tel[0]);
                          } else {
                            showPhoneSelector(contact.tel, function(selectedPhone) {
                              const phoneInput = document.getElementById('vendor_phone_input');
                              if (selectedPhone && phoneInput) phoneInput.value = formatPhoneNumber(selectedPhone);
                            });
                          }
                        }
                      }
                    } catch (ex) {
                      console.error('연락처 불러오기 실패:', ex);
                    }
                  } else {
                    alert('이 기기에서는 연락처 불러오기를 지원하지 않습니다.');
                  }
                } catch (err) {
                  console.error('Contact error:', err);
                  alert('연락처 플러그인 에러: ' + (err.message || JSON.stringify(err)));
                }
              });
            }

            // 다중 연락처 선택용 바텀 시트 UI
            function showPhoneSelector(phones, callback) {
              const overlay = document.createElement('div');
              overlay.style.position = 'fixed';
              overlay.style.top = '0'; overlay.style.left = '0'; overlay.style.right = '0'; overlay.style.bottom = '0';
              overlay.style.backgroundColor = 'rgba(0,0,0,0.5)';
              overlay.style.zIndex = '99999';
              overlay.style.display = 'flex';
              overlay.style.alignItems = 'flex-end';
              
              const sheet = document.createElement('div');
              sheet.style.width = '100%';
              sheet.style.backgroundColor = '#fff';
              sheet.style.borderTopLeftRadius = '24px';
              sheet.style.borderTopRightRadius = '24px';
              sheet.style.padding = '24px 20px 40px 20px';
              sheet.style.boxSizing = 'border-box';
              sheet.style.transform = 'translateY(100%)';
              sheet.style.transition = 'transform 0.3s ease-out';
              
              const title = document.createElement('div');
              title.textContent = '저장할 연락처를 선택해주세요';
              title.style.fontSize = '18px';
              title.style.fontWeight = '900';
              title.style.marginBottom = '20px';
              title.style.textAlign = 'center';
              sheet.appendChild(title);

              phones.forEach((p) => {
                let pNum = p.number || p;
                if (typeof pNum === 'object') pNum = pNum.number;
                
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.style.width = '100%';
                btn.style.padding = '16px';
                btn.style.marginBottom = '12px';
                btn.style.backgroundColor = '#f9fafb';
                btn.style.border = '1px solid #e5e7eb';
                btn.style.borderRadius = '16px';
                btn.style.fontSize = '16px';
                btn.style.fontWeight = '800';
                btn.style.color = '#111827';
                btn.style.cursor = 'pointer';
                
                let labelText = formatPhoneNumber(pNum);
                if (p.label) labelText += ` (${p.label})`;
                else if (p.type && typeof p.type === 'string') labelText += ` (${p.type})`;
                btn.textContent = labelText;
                
                btn.onclick = () => {
                  closeSheet();
                  callback(pNum);
                };
                sheet.appendChild(btn);
              });
              
              const cancelBtn = document.createElement('button');
              cancelBtn.type = 'button';
              cancelBtn.style.width = '100%';
              cancelBtn.style.padding = '16px';
              cancelBtn.style.backgroundColor = 'transparent';
              cancelBtn.style.border = 'none';
              cancelBtn.style.fontSize = '15px';
              cancelBtn.style.fontWeight = '700';
              cancelBtn.style.color = '#6b7280';
              cancelBtn.style.cursor = 'pointer';
              cancelBtn.textContent = '취소';
              cancelBtn.onclick = () => { closeSheet(); };
              sheet.appendChild(cancelBtn);

              overlay.appendChild(sheet);
              document.body.appendChild(overlay);

              setTimeout(() => { sheet.style.transform = 'translateY(0)'; }, 10);

              function closeSheet() {
                sheet.style.transform = 'translateY(100%)';
                setTimeout(() => { document.body.removeChild(overlay); }, 300);
              }
            }
          })();
        </script>

        <%# 메모 %>
        <div>
          <label style="font-size:13px; font-weight:800; color:#374151; display:block; margin-bottom:6px;">메모</label>
          <%= f.text_area :memo, placeholder: "전문분야, 결제 조건, 특이사항 등",
              rows: 3,
              style: "width:100%; border:1.5px solid #e5e7eb; border-radius:12px; padding:12px 14px; font-size:14px; font-weight:600; font-family:inherit; box-sizing:border-box; resize:none; line-height:1.6;" %>
        </div>

      </div>

      <%# Action buttons - 수정 완료 버튼만 form 안에 %>
      <div style="display:flex; flex-direction:column; gap:10px; margin-top:20px;">
        <%= f.submit vendor.new_record? ? "업체 등록하기" : "수정 완료",
            style: "display:block; width:100%; padding:16px; background:#111827; color:white; border:none; border-radius:14px; font-size:18px; font-weight:900; cursor:pointer; font-family:inherit; box-sizing:border-box;" %>
      </div>

    <% end %>
    <%# 삭제·취소 버튼은 form 바깥에 위치 (form 중첩 방지) %>
    <div style="display:flex; flex-direction:column; gap:10px; margin-top:10px;">
      <% unless vendor.new_record? %>
        <%= button_to "업체 삭제", vendor_path(vendor), method: :delete,
            form: { onsubmit: "return confirm('\"#{vendor.name}\" 업체를 삭제할까요?');" },
            style: "width:100%; padding:14px; background:#fee2e2; color:#dc2626; border:none; border-radius:14px; font-size:16px; font-weight:900; cursor:pointer; font-family:inherit;" %>
      <% end %>

      <%= link_to "취소", vendors_path,
          style: "display:block; width:100%; padding:14px; background:#e5e7eb; color:#374151; border-radius:14px; font-size:16px; font-weight:800; text-decoration:none; text-align:center; box-sizing:border-box;" %>
    </div>
    </div>
  </div>
</div>

<!-- iOS/Android compatible popup layer -->
<div id="daum_postcode_layer" style="display:none;position:fixed;overflow:hidden;z-index:9999;-webkit-overflow-scrolling:touch;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);">
  <div style="position:absolute;top:50%;left:50%;transform:translate(-50%, -50%);width:90%;max-width:500px;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 10px 25px rgba(0,0,0,0.2);">
    <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 18px;background:#f9fafb;border-bottom:1px solid #e5e7eb;">
      <span style="font-weight:800; color:#111;">주소 검색</span>
      <button type="button" onclick="closeDaumPostcode()" style="background:none;border:none;font-size:26px;line-height:1;cursor:pointer;color:#6b7280;padding:0;margin:0;">&times;</button>
    </div>
    <div id="daum_postcode_wrap" style="width:100%;height:450px;max-height:70vh;"></div>
  </div>
</div>

<script src="//t1.kakaocdn.net/mapjsapi/bundle/postcode/prod/postcode.v2.js"></script>

<script>
  function closeDaumPostcode() {
    document.getElementById('daum_postcode_layer').style.display = 'none';
  }

  document.addEventListener("DOMContentLoaded", function () {
    const addressSearchButton = document.getElementById("vendor_address_search_button");
    const addressField = document.getElementById("vendor_address");
    const detailAddressField = document.getElementById("vendor_detail_address");

    if (addressSearchButton) {
      addressSearchButton.addEventListener("click", function () {
        var layer = document.getElementById('daum_postcode_layer');
        var wrap = document.getElementById('daum_postcode_wrap');
        layer.style.display = 'block';

        new daum.Postcode({
          oncomplete: function(data) {
            let addr = "";
            let extraAddr = "";

            if (data.userSelectedType === "R") {
              addr = data.roadAddress;
            } else {
              addr = data.jibunAddress;
            }

            if (data.userSelectedType === "R") {
              if (data.bname && /[동|로|가]$/g.test(data.bname)) {
                extraAddr += data.bname;
              }
              if (data.buildingName && data.apartment === "Y") {
                extraAddr += (extraAddr !== "" ? ", " + data.buildingName : data.buildingName);
              }
              if (extraAddr !== "") {
                extraAddr = " (" + extraAddr + ")";
              }
            }

            addressField.value = addr + extraAddr;
            document.getElementById("vendor_address_display_text").textContent = addr + extraAddr;
            document.getElementById("vendor_address_display_text").style.color = "#111827";
            detailAddressField.focus();
            closeDaumPostcode();
          },
          width: '100%',
          height: '100%',
          maxSuggestItems: 5
        }).embed(wrap);
      });
    }

    // 폼 제출 시 상세 주소 병합
    if (addressField) {
      const form = addressField.closest("form");
      if (form) {
        form.addEventListener("submit", function (e) {
          if (detailAddressField && detailAddressField.value.trim() !== "") {
            const detailValue = detailAddressField.value.trim();
            // 이미 주소에 포함되어 있지 않은 경우에만 병합
            if (!addressField.value.includes(detailValue)) {
              addressField.value = addressField.value.trim() + " " + detailValue;
            }
          }
        });
      }
    }
  });
</script>
