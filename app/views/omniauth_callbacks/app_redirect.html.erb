<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>로그인 완료</title>
  <style>
    body {
      margin: 0; padding: 0;
      background: #0a0f1e;
      display: flex; align-items: center; justify-content: center;
      min-height: 100vh;
      font-family: -apple-system, BlinkMacSystemFont, 'Pretendard', sans-serif;
      color: white;
    }
    .container { text-align: center; padding: 24px; }
    .spinner {
      width: 40px; height: 40px;
      border: 3px solid rgba(255,255,255,0.15);
      border-top: 3px solid #2563eb;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 20px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .check-icon {
      font-size: 48px;
      margin-bottom: 16px;
    }
    h2 { font-size: 18px; margin-bottom: 8px; font-weight: 900; }
    p { font-size: 14px; color: rgba(255,255,255,0.6); line-height: 1.6; }
    .btn {
      display: inline-block; margin-top: 16px;
      padding: 14px 28px; background: linear-gradient(90deg, #2563eb, #3b82f6);
      color: white; border-radius: 14px;
      text-decoration: none; font-weight: 800; font-size: 15px;
      box-shadow: 0 4px 16px rgba(37,99,235,0.3);
      transition: all 0.2s;
    }
    .btn:active { transform: scale(0.97); }
  </style>
</head>
<body>
  <div class="container">
    <div class="spinner" id="loadingSpinner"></div>
    <div class="check-icon" id="checkIcon" style="display:none;">✅</div>
    <h2 id="statusTitle">로그인 성공!</h2>
    <p id="statusMsg">앱으로 돌아가는 중...</p>
    <a class="btn" href="#" id="return-btn" style="display:none;">앱으로 돌아가기</a>
  </div>
  <script>
    var deepLink = '<%= @deep_link %>';
    var token = deepLink.split('token=')[1];

    // 즉시 딥링크 시도
    function tryDeepLink() {
      try {
        var iframe = document.createElement('iframe');
        iframe.style.display = 'none';
        iframe.src = deepLink;
        document.body.appendChild(iframe);
      } catch(e) {}

      setTimeout(function() {
        window.location.href = deepLink;
      }, 300);
    }

    // 즉시 실행
    tryDeepLink();

    // 2초 후: 재시도
    setTimeout(function() {
      window.location.href = deepLink;
    }, 2000);

    // 4초 후: 버튼 표시 (자동 전환 안 될 경우)
    setTimeout(function() {
      document.getElementById('loadingSpinner').style.display = 'none';
      document.getElementById('checkIcon').style.display = 'block';
      document.getElementById('statusMsg').innerHTML =
        '자동 전환이 안 될 경우<br><b>아래 버튼</b>을 눌러주세요';
      document.getElementById('statusMsg').style.color = 'rgba(255,255,255,0.8)';

      var returnBtn = document.getElementById('return-btn');
      returnBtn.style.display = 'inline-block';
      returnBtn.href = deepLink;
      returnBtn.addEventListener('click', function(e) {
        e.preventDefault();
        window.location.href = deepLink;
      });
    }, 4000);

    // 팝업/외부 브라우저에서 열렸으면 닫기 시도
    if (window.opener && window.opener !== window) {
      setTimeout(function() { window.close(); }, 3000);
    }
  </script>
</body>
</html>
