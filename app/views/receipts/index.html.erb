<script src="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.css" />
<% content_for :title, "영수증 관리" %>

<%
  start_date = @current_date.beginning_of_month.beginning_of_week(:sunday)
  end_date = @current_date.end_of_month.end_of_week(:sunday)
  date_range = (start_date..end_date).to_a
%>

<div class="top-header" style="background:white; padding:18px 20px 14px 20px; border-bottom:1px solid #ececec; position:sticky; top:0; z-index:30;">
  <div style="display:flex; justify-content:space-between; align-items:center;">
    <div style="font-size:24px; color:#111827; font-weight:900; cursor:pointer;" onclick="openDrawer()">☰</div>
    <div style="font-size:20px; font-weight:900; color:#111827;">영수증 관리</div>
    <div style="width:24px;"></div>
  </div>
</div>

<!-- 월 선택 헤더 -->
<div style="background:white; padding:16px 20px; display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #f3f4f6;">
  <% prev_month = @current_date - 1.month %>
  <% next_month = @current_date + 1.month %>
  <%= link_to receipts_path(year: prev_month.year, month: prev_month.month), style: "padding:8px; color:#6b7280; text-decoration:none;" do %>
    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
  <% end %>
  
  <div style="font-size:18px; font-weight:800; color:#111827;">
    <%= @current_date.strftime("%Y년 %-m월") %>
  </div>

  <%= link_to receipts_path(year: next_month.year, month: next_month.month), style: "padding:8px; color:#6b7280; text-decoration:none;" do %>
    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
  <% end %>
</div>

<!-- 캘린더 영역 -->
<div style="background:white; padding:12px 20px 24px 20px;">
  <!-- 요일 헤더 -->
  <div style="display:grid; grid-template-columns:repeat(7, 1fr); text-align:center; margin-bottom:8px;">
    <% %w[일 월 화 수 목 금 토].each_with_index do |day, i| %>
      <div style="font-size:12px; font-weight:700; color:<%= i==0 ? '#ef4444' : (i==6 ? '#3b82f6' : '#6b7280') %>;">
        <%= day %>
      </div>
    <% end %>
  </div>

  <!-- 날짜 그리드 -->
  <div style="display:grid; grid-template-columns:repeat(7, 1fr); gap:6px;">
    <% date_range.each do |date| %>
      <% is_current_month = date.month == @current_date.month %>
      <div style="aspect-ratio:1; border-radius:8px; padding:4px; display:flex; flex-direction:column; align-items:center; background:<%= date == Date.current ? '#eff6ff' : 'transparent' %>; <%= is_current_month ? '' : 'opacity:0.3;' %>">
        <div style="font-size:13px; font-weight:700; color:<%= date.wday==0 ? '#ef4444' : (date.wday==6 ? '#3b82f6' : '#111827') %>;">
          <%= date.day %>
        </div>
        
        <% if @receipts_by_date[date].present? %>
          <div style="margin-top:auto; background:#4f46e5; color:white; font-size:10px; font-weight:800; border-radius:999px; padding:2px 6px;">
            <%= @receipts_by_date[date].size %>장
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<div style="height:8px; background:#f3f4f6;"></div>

<!-- 날짜별 영수증 목록 썸네일 그리드 -->
<div style="padding:20px; padding-bottom:100px;">
  <% has_receipts = false %>
  <% @receipts_by_date.sort.reverse.each do |date, receipts| %>
    <% next if date.month != @current_date.month %>
    <% has_receipts = true %>
    <div style="margin-bottom:28px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <h3 style="font-size:16px; font-weight:800; color:#111827; margin:0;">
          <%= date.strftime("%-m월 %-d일") %> 
          <span style="font-size:14px; font-weight:600; color:#6b7280; margin-left:4px;">
            (<%= %w[일 월 화 수 목 금 토][date.wday] %>)
          </span>
        </h3>
        <span style="font-size:13px; font-weight:700; color:#4f46e5;"><%= receipts.size %>장</span>
      </div>

      <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:8px;">
        <% receipts.each do |r| %>
          <% if r.image.attached? %>
            <div style="position:relative; aspect-ratio:1; border-radius:8px; overflow:hidden; background:#f3f4f6;">
              <a href="<%= url_for(r.image) %>" data-fancybox="receipts-gallery" data-type="image" style="display:block; width:100%; height:100%;">
                <%= image_tag r.image, style: "width:100%; height:100%; object-fit:cover; cursor:zoom-in;" %>
              </a>
              
              <!-- 삭제 버튼 -->
              <%= button_to receipt_path(r), method: :delete, data: { turbo_confirm: "이미지를 영구적으로 삭제하시겠습니까?" }, style: "position:absolute; top:4px; right:4px; background:rgba(0,0,0,0.6); border:none; border-radius:50%; width:24px; height:24px; display:flex; align-items:center; justify-content:center; color:white; cursor:pointer;" do %>
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% unless has_receipts %>
    <div style="text-align:center; padding:60px 0; color:#6b7280;">
      <div style="font-size:48px; margin-bottom:16px;">📸</div>
      <div style="font-size:16px; font-weight:600; color:#374151; margin-bottom:8px;">저장된 사진이 없습니다</div>
      <div style="font-size:14px; line-height:1.5;">우측 하단 + 버튼을 눌러<br>영수증을 촬영해보세요.</div>
    </div>
  <% end %>
</div>

<!-- 플로팅 액션 버튼 -->
<%= link_to new_receipt_path(date: Date.current.to_s), style: "position:fixed; bottom:80px; right:20px; width:60px; height:60px; background:#4f46e5; color:white; border-radius:30px; display:flex; align-items:center; justify-content:center; box-shadow:0 4px 12px rgba(79, 70, 229, 0.4); z-index:40;" do %>
  <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
  </svg>
<% end %>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    Fancybox.bind('[data-fancybox="receipts-gallery"]', {
      Toolbar: false,
      dragToClose: false,
      Images: {
        zoom: true,
      },
      on: {
        ready: (fancybox) => {
          const banner = document.createElement('div');
          banner.id = 'fancybox-custom-close-banner';
          banner.style.position = 'fixed';
          banner.style.bottom = '95px';
          banner.style.left = '50%';
          banner.style.transform = 'translateX(-50%)';
          banner.style.width = '90%';
          banner.style.maxWidth = '300px';
          banner.style.zIndex = '9999999';
          banner.style.display = 'flex';
          banner.style.justifyContent = 'center';
          
          const btn = document.createElement('button');
          btn.style.width = '100%';
          btn.style.padding = '14px';
          btn.style.borderRadius = '999px';
          btn.style.background = 'rgba(30, 30, 30, 0.85)';
          btn.style.backdropFilter = 'blur(10px)';
          btn.style.color = 'white';
          btn.style.fontSize = '16px';
          btn.style.fontWeight = '800';
          btn.style.border = '1px solid rgba(255,255,255,0.2)';
          btn.style.boxShadow = '0 6px 16px rgba(0,0,0,0.5)';
          btn.style.cursor = 'pointer';
          btn.innerText = '✕ 사진 닫기';
          
          banner.appendChild(btn);
          banner.onclick = () => Fancybox.close();
          fancybox.container.appendChild(banner);
        }
      }
    });
  });
</script>
