            Toolbar: false,
            dragToClose: false,
            Images: {
              zoom: true,
            },
            on: {
              ready: (fancybox) => {
                // 하단 닫기 버튼 (썸네일 위 플로팅) 생성
                const banner = document.createElement('div');
                banner.id = 'fancybox-custom-close-banner';
                banner.style.position = 'fixed';
                banner.style.bottom = '95px'; // 썸네일(보통 70~80px) 위로 띄움
