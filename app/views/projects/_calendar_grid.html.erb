<% @calendar_rows.each_with_index do |row_days, row_index| %>
  <div style="flex:0 0 auto; border-bottom:<%= row_index == @calendar_rows.length - 1 ? 'none' : '1px solid #f3f4f6' %>; display:flex; flex-direction:column;">
    <div style="display:grid; grid-template-columns:repeat(7, minmax(0, 1fr));">
      <% row_days.each do |day| %>
        <% is_current_month = (day.month == @calendar_month) %>
        <% is_today = (day == Date.current) %>
        <% day_projects = @projects_by_date[day] || [] %>
        <% day_consultations = @consultations_by_date && @consultations_by_date[day] || [] %>

        <% holiday = HolidayHelper.get_holiday(day) %>
        <% is_holiday = holiday.present? %>
        <% holiday_name = holiday[:name] if is_holiday %>

        <% date_text_color = if !is_current_month
            '#9ca3af'
          elsif day.sunday? || is_holiday
            '#ef4444'
          elsif day.saturday?
            '#3b82f6'
          else
            '#111827'
          end %>

        <div class="calendar-date-cell"
             data-date="<%= day.to_s %>"
             style="
              min-height:<%= local_assigns[:cell_min_height] || '108px' %>;
              border-right:none;
              padding:3px 2px 2px 2px;
              box-sizing:border-box;
              background:white;
              display:flex;
              flex-direction:column;
              align-items:stretch;
              cursor:pointer;
              transition: background 0.2s;
            ">
          <div style="display:flex; justify-content:center; margin-bottom:4px; padding:0 2px;">
            <div style="
              display:flex;
              align-items:center;
              justify-content:center;
              width:100%;
              height:18px;
              border-radius:4px;
              font-size:11px;
              font-weight:900;
              color:<%= is_today ? 'white' : date_text_color %>;
              background:<%= is_today ? '#f59e0b' : 'transparent' %>;
            "><%= format('%02d', day.day) %></div>
          </div>


          <% if is_current_month %>
            <%
              day_as_items = day_consultations.select { |c| c.schedule_type == 'as' }
              day_couns_items = day_consultations.reject { |c| c.schedule_type == 'as' }
              
              calendar_items = []
              if day_couns_items.any?
                calendar_items << { type: 'consultation', label: "상담 #{day_couns_items.size > 1 ? day_couns_items.size : ''}".strip }
              end
              if day_as_items.any?
                calendar_items << { type: 'as', label: "AS #{day_as_items.size > 1 ? day_as_items.size : ''}".strip }
              end
              
              day_projects.each do |proj|
                calendar_items << { type: 'project', label: (proj.client_name.presence || proj.project_name), id: proj.id }
              end
            %>
            <% calendar_items.each_with_index do |item, idx| %>
              <%
                color_style = case idx
                  when 0 then "color:#1d4ed8; background:#dbeafe; border:1px solid #93c5fd;"
                  when 1 then "color:#6d28d9; background:#ede9fe; border:1px solid #c4b5fd;"
                  when 2 then "color:#15803d; background:#dcfce7; border:1px solid #86efac;"
                  when 3 then "color:#ea580c; background:#ffedd5; border:1px solid #fdba74;"
                  else        "color:#be123c; background:#ffe4e6; border:1px solid #fda4af;"
                  end
              %>
              <% if item[:type] == 'project' %>
                <div class="schedule-chip"
                     draggable="true"
                     data-project-id="<%= item[:id] %>"
                     data-date="<%= day.to_s %>"
                     onclick="if(typeof openChipMenu === 'function') { openChipMenu(event, '<%= item[:id] %>', '<%= j(item[:label]) %>', '<%= day.to_s %>'); } else { window.location.href='<%= "/projects/#{item[:id]}" %>'; }"
                     style="font-size:10px; font-weight:800; <%= color_style %> border-radius:4px; padding:3px 4px; margin-bottom:2px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; cursor:grab; user-select:none; -webkit-user-select:none; text-align:center;">
                  <%= item[:label] %>
                </div>
              <% elsif item[:type] == 'consultation' %>
                <div class="schedule-chip consultation-chip"
                     onclick="if(typeof openBottomSheet === 'function') { event.stopPropagation(); openBottomSheet('<%= day.to_s %>'); }"
                     style="font-size:10px; font-weight:800; <%= color_style %> border-radius:4px; padding:3px 4px; margin-bottom:2px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; cursor:pointer; user-select:none; -webkit-user-select:none; text-align:center;">
                  <%= item[:label] %>
                </div>
              <% elsif item[:type] == 'as' %>
                <div class="schedule-chip as-chip"
                     onclick="if(typeof openBottomSheet === 'function') { event.stopPropagation(); openBottomSheet('<%= day.to_s %>'); }"
                     style="font-size:10px; font-weight:800; <%= color_style %> border-radius:4px; padding:3px 4px; margin-bottom:2px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; cursor:pointer; user-select:none; -webkit-user-select:none; text-align:center;">
                  <%= item[:label] %>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
